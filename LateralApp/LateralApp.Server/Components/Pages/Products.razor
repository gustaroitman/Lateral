@page "/products"
@rendermode InteractiveServer
@using LateralApp.Components.Shared

<PageTitle>Products</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Products</h1>
    <button class="btn btn-primary" @onclick="OpenAddModal">
        <span class="bi bi-plus-circle me-1"></span> New Product
    </button>
</div>

<AlertMessage Message="@_errorMessage" OnDismiss="() => _errorMessage = null" />

@if (_products is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row g-2 align-items-center mb-3">
        <div class="col-md-6">
            <input class="form-control" type="search" placeholder="Search by name..."
                   value="@_searchText" @oninput="e => OnSearchChanged(e.Value?.ToString())" />
        </div>
        <div class="col-auto">
            <div class="form-check form-check-inline mb-0">
                <input class="form-check-input" type="checkbox" id="showActiveOnly"
                       checked="@_showActiveOnly" @onchange="e => OnActiveFilterChanged((bool)e.Value!)" />
                <label class="form-check-label" for="showActiveOnly">Active only</label>
            </div>
        </div>
        <div class="col-auto ms-auto text-muted small">
            @_filteredCount products &nbsp;|&nbsp; Page @_currentPage of @_totalPages
        </div>
    </div>

    @if (_filteredCount == 0)
    {
        <p class="text-muted">No products match the current filters.</p>
    }
    else
    {
        <div class="table-responsive" style="height:560px; overflow-y:auto;">
            <table class="table table-hover align-middle" style="table-layout:fixed; width:100%;">
                <colgroup>
                    <col style="width:30%;" />
                    <col style="width:12%;" />
                    <col style="width:10%;" />
                    <col style="width:13%;" />
                    <col style="width:10%;" />
                    <col style="width:25%;" />
                </colgroup>
                <thead style="position:sticky; top:0; z-index:1; background-color:#1e3a5f; color:#ffffff; font-size:.85rem; letter-spacing:.04em; text-transform:uppercase;">
                    <tr>
                        <th>Name</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-end">Quantity</th>
                        <th class="text-end">Total Price</th>
                        <th class="text-center">Active</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <Virtualize @ref="_virtualizeRef"
                                ItemsProvider="ProvideProductsAsync"
                                ItemSize="53"
                                SpacerElement="tr"
                                Context="product">
                        <tr @key="product.Id">
                            <td>@product.Name</td>
                            <td class="text-end">@product.Price.ToString("C")</td>
                            <td class="text-end">@product.Quantity</td>
                            <td class="text-end">@((product.Price * product.Quantity).ToString("C"))</td>
                            <td class="text-center">
                                @if (product.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(product)">
                                    <span class="bi bi-pencil"></span> Edit
                                </button>
                                @if (product.IsActive)
                                {
                                    <button class="btn btn-sm btn-outline-warning me-1" @onclick="() => SetActiveAsync(product, false)">
                                        <span class="bi bi-slash-circle"></span> Deactivate
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-success me-1" @onclick="() => SetActiveAsync(product, true)">
                                        <span class="bi bi-check-circle"></span> Activate
                                    </button>
                                }
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => OpenDeleteConfirm(product)">
                                    <span class="bi bi-trash"></span> Delete
                                </button>
                            </td>
                        </tr>
                    </Virtualize>
                </tbody>
            </table>
        </div>

        <nav class="d-flex justify-content-center mt-3" aria-label="Products pagination">
            <ul class="pagination mb-0">
                <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToPageAsync(1)" disabled="@(_currentPage == 1)">«</button>
                </li>
                <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToPageAsync(_currentPage - 1)" disabled="@(_currentPage == 1)">‹</button>
                </li>

                @foreach (var page in GetPageNumbers())
                {
                    var p = page;
                    <li class="page-item @(p == _currentPage ? "active" : "")">
                        <button class="page-link" @onclick="() => GoToPageAsync(p)">@p</button>
                    </li>
                }

                <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToPageAsync(_currentPage + 1)" disabled="@(_currentPage == _totalPages)">›</button>
                </li>
                <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToPageAsync(_totalPages)" disabled="@(_currentPage == _totalPages)">»</button>
                </li>
            </ul>
        </nav>
    }
}

<ProductFormModal Model="_formDto"
                  Visible="@_showFormModal"
                  IsSaving="_isSaving"
                  OnClose="CloseFormModal"
                  OnValidSubmit="SaveProductAsync" />

<ConfirmModal Title="Confirm Delete"
              Visible="@(_productToDelete is not null)"
              IsBusy="@_isSaving"
              ConfirmLabel="Delete"
              OnConfirm="ConfirmDeleteAsync"
              OnCancel="CloseDeleteConfirm">
    <Message>
        Are you sure you want to delete <strong>@_productToDelete?.Name</strong>?
    </Message>
</ConfirmModal>


