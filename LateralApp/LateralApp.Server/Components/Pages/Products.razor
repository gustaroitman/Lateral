@page "/products"
@rendermode InteractiveServer
@using Lateral.Application.Products
@using Lateral.Domain.Exceptions
@using LateralApp.Components.Shared
@inject IProductService ProductService

<PageTitle>Products</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Products</h1>
    <button class="btn btn-primary" @onclick="OpenAddModal">
        <span class="bi bi-plus-circle me-1"></span> New Product
    </button>
</div>

@if (_errorMessage is not null)
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        @_errorMessage
        <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
    </div>
}

@if (_products is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row g-2 align-items-center mb-3">
        <div class="col-md-6">
            <input class="form-control" type="search" placeholder="Search by name..."
                   @bind="_searchText" @bind:event="oninput" />
        </div>
        <div class="col-auto">
            <div class="form-check form-check-inline mb-0">
                <input class="form-check-input" type="checkbox" id="showActiveOnly"
                       @bind="_showActiveOnly" />
                <label class="form-check-label" for="showActiveOnly">Active only</label>
            </div>
        </div>
    </div>

    @if (!_filteredProducts.Any())
    {
        <p class="text-muted">No products match the current filters.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-end">Quantity</th>
                        <th class="text-end">Total Price</th>
                        <th class="text-center">Active</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in _filteredProducts)
                    {
                        <tr @key="product.Id">
                            <td>@product.Name</td>
                            <td class="text-end">@product.Price.ToString("C")</td>
                            <td class="text-end">@product.Quantity</td>
                            <td class="text-end">@((product.Price * product.Quantity).ToString("C"))</td>
                            <td class="text-center">
                                @if (product.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(product)">
                                    <span class="bi bi-pencil"></span> Edit
                                </button>
                                @if (product.IsActive)
                                {
                                    <button class="btn btn-sm btn-outline-warning me-1" @onclick="() => SetActiveAsync(product, false)">
                                        <span class="bi bi-slash-circle"></span> Deactivate
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-success me-1" @onclick="() => SetActiveAsync(product, true)">
                                        <span class="bi bi-check-circle"></span> Activate
                                    </button>
                                }
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => OpenDeleteConfirm(product)">
                                    <span class="bi bi-trash"></span> Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

<ProductFormModal Model="_formDto"
                  Visible="@_showFormModal"
                  IsSaving="_isSaving"
                  OnClose="CloseFormModal"
                  OnValidSubmit="SaveProductAsync" />

@if (_productToDelete is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                    <button type="button" class="btn-close" @onclick="CloseDeleteConfirm"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete <strong>@_productToDelete.Name</strong>?
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseDeleteConfirm">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmDeleteAsync" disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ProductDto>? _products;
    private ProductDto _formDto = new();
    private ProductDto? _productToDelete;

    private bool _showFormModal;
    private bool _isSaving;
    private string? _errorMessage;

    private string _searchText = string.Empty;
    private bool _showActiveOnly = true;

    private IEnumerable<ProductDto> _filteredProducts =>
        _products?
            .Where(p => string.IsNullOrWhiteSpace(_searchText) ||
                        p.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
            .Where(p => !_showActiveOnly || p.IsActive)
        ?? Enumerable.Empty<ProductDto>();

    protected override async Task OnInitializedAsync()
        => await LoadProductsAsync();

    private async Task LoadProductsAsync()
    {
        var result = await ProductService.GetAllAsync();
        _products = result.ToList();
    }

    private void OpenAddModal()
    {
        _formDto = new ProductDto { IsActive = true };
        _showFormModal = true;
        _errorMessage = null;
    }

    private void OpenEditModal(ProductDto product)
    {
        _formDto = new ProductDto
        {
            Id = product.Id,
            Name = product.Name,
            Price = product.Price,
            Quantity = product.Quantity,
            IsActive = product.IsActive
        };
        _showFormModal = true;
        _errorMessage = null;
    }

    private void CloseFormModal()
    {
        _showFormModal = false;
    }

    private async Task SaveProductAsync()
    {
        _isSaving = true;
        _errorMessage = null;
        try
        {
            if (_formDto.Id != Guid.Empty)
                await ProductService.UpdateAsync(_formDto);
            else
                await ProductService.AddAsync(_formDto);

            _showFormModal = false;
            await LoadProductsAsync();
        }
        catch (RepositoryException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SetActiveAsync(ProductDto product, bool isActive)
    {
        _isSaving = true;
        _errorMessage = null;
        try
        {
            var dto = new ProductDto
            {
                Id = product.Id,
                Name = product.Name,
                Price = product.Price,
                Quantity = product.Quantity,
                IsActive = isActive
            };
            await ProductService.UpdateAsync(dto);
            await LoadProductsAsync();
        }
        catch (RepositoryException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void OpenDeleteConfirm(ProductDto product)
    {
        _productToDelete = product;
        _errorMessage = null;
    }

    private void CloseDeleteConfirm()
    {
        _productToDelete = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_productToDelete is null) return;
        _isSaving = true;

        try
        {
            await ProductService.DeleteAsync(_productToDelete.Id);
            _productToDelete = null;
            await LoadProductsAsync();
        }
        catch (RepositoryException ex)
        {
            _errorMessage = ex.Message;
            _productToDelete = null;
        }
        finally
        {
            _isSaving = false;
        }
    }
}
