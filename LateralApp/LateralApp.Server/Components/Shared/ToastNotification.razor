@inject ToastService ToastService
@implements IDisposable

<div class="toast-container">
    @foreach (var toast in _toasts)
    {
        <div class="@($"toast-item toast-item--{toast.CssType} {(toast.Visible ? "toast-item--in" : "toast-item--out")}")"
             @key="toast.Id">
            <div class="toast-item__icon-wrap">
                <span class="@($"bi {toast.Icon}")"></span>
            </div>
            <div class="toast-item__body">
                <p class="toast-item__type">@toast.CssType</p>
                <p class="toast-item__message">@toast.Message</p>
            </div>
            <button class="toast-item__close bi bi-x" @onclick="() => DismissAsync(toast)"></button>
            <div class="toast-item__progress"></div>
        </div>
    }
</div>

@code {
    private readonly List<ToastItem> _toasts = [];

    protected override void OnInitialized()
        => ToastService.OnShow += HandleShow;

    private void HandleShow(string message, ToastType type)
    {
        _ = InvokeAsync(async () =>
        {
            var item = new ToastItem(message, type);
            _toasts.Add(item);
            StateHasChanged();

            await Task.Delay(3500);
            await DismissAsync(item);
        });
    }

    private async Task DismissAsync(ToastItem item)
    {
        if (!_toasts.Contains(item)) return;
        item.Visible = false;
        StateHasChanged();
        await Task.Delay(320);
        _toasts.Remove(item);
        StateHasChanged();
    }

    public void Dispose()
        => ToastService.OnShow -= HandleShow;

    private sealed class ToastItem
    {
        public Guid Id { get; } = Guid.NewGuid();
        public string Message { get; }
        public bool Visible { get; set; } = true;
        public string CssType { get; }
        public string Icon { get; }

        public ToastItem(string message, ToastType type)
        {
            Message = message;
            (CssType, Icon) = type switch
            {
                ToastType.Error => ("error", "bi-x-circle-fill"),
                ToastType.Info  => ("info",  "bi-info-circle-fill"),
                _               => ("success", "bi-check-circle-fill")
            };
        }
    }
}
